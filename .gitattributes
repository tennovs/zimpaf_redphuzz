# Force C as primary language
**/*.c linguist-language=C
**/*.h linguist-language=C
*.py linguist-language=Python

# Mark Phuzz's code in Python as vendored (so it doesn’t count toward language stats)
phuzz/** linguist-vendored
redphuzz/mutator.py linguist-vendored

# Ignore web/testbed files
www/html/** linguist-vendored
*.zip linguist-vendored
